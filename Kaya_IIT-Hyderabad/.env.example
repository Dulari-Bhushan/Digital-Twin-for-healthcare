# Copy to .env and fill in. .env is git-ignored; never commit real keys.
# Voice and chat assistant (Sarvam AI). Without a key the app still runs; voice falls back to the browser or is hidden.
SARVAM_API_KEY=

# Japanese chat and translation (Google Gemini API). Optional: without it Japanese chat falls back to a polite message.
GEMINI_API_KEY=
